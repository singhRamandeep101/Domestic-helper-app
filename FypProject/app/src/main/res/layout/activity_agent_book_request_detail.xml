<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F5F5F5"
    android:padding="16dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- Top Gradient Title -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="24dp"
            android:elevation="6dp"
            android:layout_marginBottom="16dp"
            android:background="@drawable/card_background"
            android:gravity="center">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Booking Request Detail"
                android:textSize="28sp"
                android:textStyle="bold"
                android:textColor="#333333"
                android:gravity="center" />
        </LinearLayout>

        <!-- Booking Request Info -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/card_background"
            android:padding="16dp"
            android:elevation="4dp"
            android:layout_marginBottom="16dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Booking Request Info"
                android:textSize="20sp"
                android:textStyle="bold"
                android:gravity="center"
                android:textColor="#333333"
                android:paddingBottom="12dp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:padding="8dp">

                <TextView
                    android:id="@+id/tvRequestID"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="wrap_content"
                    android:text="Request ID: abc@gmail.com"
                    android:textSize="16sp"
                    android:textColor="#555555" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:padding="8dp">

                <TextView
                    android:id="@+id/tvRequestState"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="wrap_content"
                    android:text="Request State: abc@gmail.com"
                    android:textSize="16sp"
                    android:textColor="#555555" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:padding="8dp">

                <TextView
                    android:id="@+id/tvAgentName"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="wrap_content"
                    android:text="Agent Name: abc@gmail.com"
                    android:textSize="16sp"
                    android:textColor="#555555" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:padding="8dp">

                <TextView
                    android:id="@+id/tvEmployerName"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="wrap_content"
                    android:text="Employer Name: abc@gmail.com"
                    android:textSize="16sp"
                    android:textColor="#555555" />

                <ImageButton
                    android:id="@+id/chatEmployer"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:src="@drawable/icon_chat_24"
                    android:contentDescription="chat to Employer" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:padding="8dp">

                <TextView
                    android:id="@+id/tvHelperName"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="wrap_content"
                    android:text="DomesticHelper Name: jkw"
                    android:textSize="16sp"
                    android:textColor="#555555" />

                <ImageButton
                    android:id="@+id/chatHelper"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:src="@drawable/icon_chat_24"
                    android:contentDescription="chat to Helper" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:padding="8dp">

                <TextView
                    android:id="@+id/tvTranName"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="wrap_content"
                    android:text="Translator Name: Pending Confirmation"
                    android:textSize="16sp"
                    android:textColor="#555555" />

                <ImageButton
                    android:id="@+id/chatTranslator"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:src="@drawable/icon_chat_24"
                    android:contentDescription="chat to Translator" />
            </LinearLayout>
        </LinearLayout>

        <!-- Employer Selected Time -->
        <LinearLayout
            android:id="@+id/layoutEmployerSelectedTime"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/card_background"
            android:padding="16dp"
            android:elevation="4dp"
            android:layout_marginBottom="16dp"
            android:visibility="gone">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Employer Selected Time"
                android:textSize="20sp"
                android:textStyle="bold"
                android:gravity="center"
                android:textColor="#333333"
                android:paddingBottom="12dp" />

        </LinearLayout>

        <!-- Employer Selected Time -->
        <LinearLayout
            android:id="@+id/layoutConfirmedTime"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/card_background"
            android:padding="16dp"
            android:elevation="4dp"
            android:layout_marginBottom="16dp"
            android:visibility="gone">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Confirmed Schedule"
                android:textSize="20sp"
                android:textStyle="bold"
                android:gravity="center"
                android:textColor="#333333"
                android:paddingBottom="12dp" />

        </LinearLayout>

        <!-- Helper Selected Time -->
        <LinearLayout
            android:id="@+id/layoutHelperSelectedTime"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/card_background"
            android:padding="16dp"
            android:elevation="4dp"
            android:layout_marginBottom="16dp"
            android:visibility="gone">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Helper Selected Time"
                android:textSize="20sp"
                android:textStyle="bold"
                android:gravity="center"
                android:textColor="#333333"
                android:paddingBottom="12dp" />
        </LinearLayout>

        <!-- Translator Selected Time -->
        <LinearLayout
            android:id="@+id/layoutTranslatorSelectedTime"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@android:color/white"
            android:padding="16dp"
            android:elevation="4dp"
            android:layout_marginBottom="16dp"
            android:visibility="gone">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Translator Selected Time"
                android:textSize="20sp"
                android:textStyle="bold"
                android:gravity="center"
                android:textColor="#333333"
                android:paddingBottom="12dp" />
        </LinearLayout>

        <!-- Suggested Times -->
        <LinearLayout
            android:id="@+id/layoutMatchingTime"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@android:color/white"
            android:padding="16dp"
            android:elevation="4dp"
            android:layout_marginBottom="16dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Matching Time"
                android:textSize="20sp"
                android:textStyle="bold"
                android:gravity="center"
                android:textColor="#333333"
                android:paddingBottom="12dp" />

            <TextView
                android:id="@+id/tvNoMatchTime"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="No matching Time"
                android:textSize="15sp"
                android:gravity="center"
                android:textColor="#333333"
                android:paddingBottom="12dp" />
        </LinearLayout>

        <!-- Confirmed Times -->
        <LinearLayout
            android:id="@+id/layoutConfirmTime"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@android:color/white"
            android:padding="16dp"
            android:elevation="4dp"
            android:layout_marginBottom="16dp">

        </LinearLayout>
        <Button
            android:id="@+id/btnSendDecline"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Send Declined"
            android:textColor="@android:color/white"
            android:backgroundTint="@color/purple_500"
            android:textStyle="bold"
            android:layout_marginTop="16dp"
            android:padding="12dp"
            android:visibility="gone"/>

        <Button
            android:id="@+id/btnBook"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Book Time"
            android:textColor="@android:color/white"
            android:backgroundTint="@color/purple_500"
            android:textStyle="bold"
            android:layout_marginTop="16dp"
            android:padding="12dp"
            android:visibility="gone"/>

        <Button
            android:id="@+id/btnCheckBook"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Check Book"
            android:textColor="@android:color/white"
            android:backgroundTint="@color/purple_500"
            android:textStyle="bold"
            android:layout_marginTop="16dp"
            android:padding="12dp"
            android:visibility="gone"/>
    </LinearLayout>
</ScrollView>