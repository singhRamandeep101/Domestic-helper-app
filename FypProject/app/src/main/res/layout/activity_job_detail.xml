<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F5F5F5"
    android:padding="16dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- Top Gradient Title -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="24dp"
            android:elevation="6dp"
            android:layout_marginBottom="16dp"
            android:gravity="center">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Booking Request Detail"
                android:textSize="28sp"
                android:textStyle="bold"
                android:textColor="#FFFFFF"
                android:gravity="center" />
        </LinearLayout>

        <!-- Booking Request Info -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/card_background"
            android:padding="16dp"
            android:elevation="4dp"
            android:layout_marginBottom="16dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Booking Request Info"
                android:textSize="20sp"
                android:textStyle="bold"
                android:gravity="center"
                android:textColor="#333333"
                android:paddingBottom="12dp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Doc ID: DWOEUbcanW7HFwSO5zL4"
                android:textSize="16sp"
                android:textColor="#555555"
                android:padding="8dp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Agent State: Awaiting Helper and Translator Confirmation"
                android:textSize="16sp"
                android:textColor="#555555"
                android:padding="8dp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Employee Email: abc@gmail.com"
                android:textSize="16sp"
                android:textColor="#555555"
                android:padding="8dp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Employer Email: youtube@gmail.com"
                android:textSize="16sp"
                android:textColor="#555555"
                android:padding="8dp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Employer State: Pending Confirmation"
                android:textSize="16sp"
                android:textColor="#555555"
                android:padding="8dp" />
        </LinearLayout>

        <!-- Employer Selected Time -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/card_background"
            android:padding="16dp"
            android:elevation="4dp"
            android:layout_marginBottom="16dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Employer Selected Time"
                android:textSize="20sp"
                android:textStyle="bold"
                android:gravity="center"
                android:textColor="#333333"
                android:paddingBottom="12dp" />

            <!-- Hardcoded Date and Time -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="10 Apr, 2025 (Thu)"
                android:textSize="18sp"
                android:textStyle="bold"
                android:textColor="#333333"
                android:paddingBottom="8dp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="10:00 - 11:00"
                android:textSize="16sp"
                android:textColor="#555555"
                android:paddingBottom="4dp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="11:00 - 12:00"
                android:textSize="16sp"
                android:textColor="#555555"
                android:paddingBottom="4dp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="12:00 - 13:00"
                android:textSize="16sp"
                android:textColor="#555555"
                android:paddingBottom="4dp" />

            <!-- Another Date -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="11 Apr, 2025 (Fri)"
                android:textSize="18sp"
                android:textStyle="bold"
                android:textColor="#333333"
                android:paddingTop="12dp"
                android:paddingBottom="8dp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="14:00 - 15:00"
                android:textSize="16sp"
                android:textColor="#555555"
                android:paddingBottom="4dp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="15:00 - 16:00"
                android:textSize="16sp"
                android:textColor="#555555"
                android:paddingBottom="4dp" />
        </LinearLayout>

        <!-- Confirmed Times -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/card_background"
            android:padding="16dp"
            android:elevation="4dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Confirmed Times"
                android:textSize="20sp"
                android:textStyle="bold"
                android:gravity="center"
                android:textColor="#333333"
                android:paddingBottom="12dp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="(Selected 'Yes' times will appear here dynamically)"
                android:textSize="16sp"
                android:textColor="#999999"
                android:gravity="center"
                android:paddingBottom="8dp" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>