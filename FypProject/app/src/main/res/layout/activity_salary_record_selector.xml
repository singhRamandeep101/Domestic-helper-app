<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    tools:context=".activities.SalaryRecordSelectorActivity">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <androidx.appcompat.widget.Toolbar
            android:id="@+id/toolBar"
            android:layout_width="match_parent"
            android:layout_height="110dp"
            android:elevation="4dp"
            android:paddingTop="50dp"
            android:background="@color/surface_tint"
            android:theme="@style/ThemeOverlay.AppCompat.Dark.ActionBar"
            android:popupTheme="@style/ThemeOverlay.AppCompat.Light"/>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:gravity="center">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center"
                android:padding="20dp">

                <ImageView
                    android:id="@+id/btnLastYear"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:src="@drawable/left_arrow"/>

                <TextView
                    android:id="@+id/year"
                    android:layout_width="wrap_content"
                    android:layout_height="40dp"
                    android:text="2025"
                    android:textSize="30dp"
                    android:textColor="@color/black"
                    android:textStyle="bold"
                    android:layout_marginHorizontal="20dp"/>

                <ImageView
                    android:id="@+id/btnNextYear"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:src="@drawable/right_arrow"/>

            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center"
                android:padding="5dp">



                <LinearLayout
                    android:id="@+id/month_1"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_margin="10dp"
                    android:background="@drawable/card"
                    android:gravity="center"
                    android:orientation="horizontal"
                    android:paddingHorizontal="10dp"
                    android:paddingVertical="15dp"
                    android:elevation="4dp">

                    <ImageView
                        android:id="@+id/month_status_1"
                        android:layout_width="25dp"
                        android:layout_height="25dp"
                        android:src="@drawable/icon_add_circle" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="10dp"
                        android:text="Jan"
                        android:textColor="@color/light_primary"
                        android:textSize="20dp" />

                </LinearLayout>
                <LinearLayout
                    android:id="@+id/month_2"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_margin="10dp"
                    android:background="@drawable/card"
                    android:gravity="center"
                    android:orientation="horizontal"
                    android:paddingHorizontal="10dp"
                    android:paddingVertical="15dp"
                    android:elevation="4dp">

                    <ImageView
                        android:id="@+id/month_status_2"
                        android:layout_width="25dp"
                        android:layout_height="25dp"
                        android:src="@drawable/icon_add_circle" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="10dp"
                        android:text="Feb"
                        android:textColor="@color/light_primary"
                        android:textSize="20dp" />

                </LinearLayout>
                <LinearLayout
                    android:id="@+id/month_3"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_margin="10dp"
                    android:background="@drawable/card"
                    android:gravity="center"
                    android:orientation="horizontal"
                    android:paddingHorizontal="10dp"
                    android:paddingVertical="15dp"
                    android:elevation="4dp">

                    <ImageView
                        android:id="@+id/month_status_3"
                        android:layout_width="25dp"
                        android:layout_height="25dp"
                        android:src="@drawable/icon_add_circle" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="10dp"
                        android:text="Mar"
                        android:textColor="@color/light_primary"
                        android:textSize="20dp" />

                </LinearLayout>


            </LinearLayout>
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center"
                android:padding="5dp">

                <LinearLayout
                    android:id="@+id/month_4"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_margin="10dp"
                    android:background="@drawable/card"
                    android:gravity="center"
                    android:orientation="horizontal"
                    android:paddingHorizontal="10dp"
                    android:paddingVertical="15dp"
                    android:elevation="4dp">

                    <ImageView
                        android:id="@+id/month_status_4"
                        android:layout_width="25dp"
                        android:layout_height="25dp"
                        android:src="@drawable/icon_add_circle" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="10dp"
                        android:text="Apr"
                        android:textColor="@color/light_primary"
                        android:textSize="20dp" />

                </LinearLayout>
                <LinearLayout
                    android:id="@+id/month_5"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_margin="10dp"
                    android:background="@drawable/card"
                    android:gravity="center"
                    android:orientation="horizontal"
                    android:paddingHorizontal="10dp"
                    android:paddingVertical="15dp"
                    android:elevation="4dp">

                    <ImageView
                        android:id="@+id/month_status_5"
                        android:layout_width="25dp"
                        android:layout_height="25dp"
                        android:src="@drawable/icon_add_circle" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="10dp"
                        android:text="May"
                        android:textColor="@color/light_primary"
                        android:textSize="20dp" />

                </LinearLayout>
                <LinearLayout
                    android:id="@+id/month_6"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_margin="10dp"
                    android:background="@drawable/card"
                    android:gravity="center"
                    android:orientation="horizontal"
                    android:paddingHorizontal="10dp"
                    android:paddingVertical="15dp"
                    android:elevation="4dp">

                    <ImageView
                        android:id="@+id/month_status_6"
                        android:layout_width="25dp"
                        android:layout_height="25dp"
                        android:src="@drawable/icon_add_circle" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="10dp"
                        android:text="Jun"
                        android:textColor="@color/light_primary"
                        android:textSize="20dp" />

                </LinearLayout>


            </LinearLayout>
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center"
                android:padding="5dp">

                <LinearLayout
                    android:id="@+id/month_7"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_margin="10dp"
                    android:background="@drawable/card"
                    android:gravity="center"
                    android:orientation="horizontal"
                    android:paddingHorizontal="10dp"
                    android:paddingVertical="15dp"
                    android:elevation="4dp">

                    <ImageView
                        android:id="@+id/month_status_7"
                        android:layout_width="25dp"
                        android:layout_height="25dp"
                        android:src="@drawable/icon_add_circle" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="10dp"
                        android:text="Jul"
                        android:textColor="@color/light_primary"
                        android:textSize="20dp" />

                </LinearLayout>
                <LinearLayout
                    android:id="@+id/month_8"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_margin="10dp"
                    android:background="@drawable/card"
                    android:gravity="center"
                    android:orientation="horizontal"
                    android:paddingHorizontal="10dp"
                    android:paddingVertical="15dp"
                    android:elevation="4dp">

                    <ImageView
                        android:id="@+id/month_status_8"
                        android:layout_width="25dp"
                        android:layout_height="25dp"
                        android:src="@drawable/icon_add_circle" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="10dp"
                        android:text="Aug"
                        android:textColor="@color/light_primary"
                        android:textSize="20dp" />

                </LinearLayout>
                <LinearLayout
                    android:id="@+id/month_9"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_margin="10dp"
                    android:background="@drawable/card"
                    android:gravity="center"
                    android:orientation="horizontal"
                    android:paddingHorizontal="10dp"
                    android:paddingVertical="15dp"
                    android:elevation="4dp">

                    <ImageView
                        android:id="@+id/month_status_9"
                        android:layout_width="25dp"
                        android:layout_height="25dp"
                        android:src="@drawable/icon_add_circle" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="10dp"
                        android:text="Sep"
                        android:textColor="@color/light_primary"
                        android:textSize="20dp" />

                </LinearLayout>


            </LinearLayout>
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center"
                android:padding="5dp"
                android:layout_marginBottom="80dp">

                <LinearLayout
                    android:id="@+id/month_10"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_margin="10dp"
                    android:background="@drawable/card"
                    android:gravity="center"
                    android:orientation="horizontal"
                    android:paddingHorizontal="10dp"
                    android:paddingVertical="15dp"
                    android:elevation="4dp">

                    <ImageView
                        android:id="@+id/month_status_10"
                        android:layout_width="25dp"
                        android:layout_height="25dp"
                        android:src="@drawable/icon_add_circle" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="10dp"
                        android:text="Oct"
                        android:textColor="@color/light_primary"
                        android:textSize="20dp" />

                </LinearLayout>
                <LinearLayout
                    android:id="@+id/month_11"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_margin="10dp"
                    android:background="@drawable/card"
                    android:gravity="center"
                    android:orientation="horizontal"
                    android:paddingHorizontal="10dp"
                    android:paddingVertical="15dp"
                    android:elevation="4dp">

                    <ImageView
                        android:id="@+id/month_status_11"
                        android:layout_width="25dp"
                        android:layout_height="25dp"
                        android:src="@drawable/icon_add_circle" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="10dp"
                        android:text="Nov"
                        android:textColor="@color/light_primary"
                        android:textSize="20dp" />

                </LinearLayout>
                <LinearLayout
                    android:id="@+id/month_12"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_margin="10dp"
                    android:background="@drawable/card"
                    android:gravity="center"
                    android:orientation="horizontal"
                    android:paddingHorizontal="10dp"
                    android:paddingVertical="15dp"
                    android:elevation="4dp">

                    <ImageView
                        android:id="@+id/month_status_12"
                        android:layout_width="25dp"
                        android:layout_height="25dp"
                        android:src="@drawable/icon_add_circle" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="10dp"
