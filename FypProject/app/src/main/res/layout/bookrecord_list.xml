<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="16dp"
    android:background="@android:color/white"
    app:cardCornerRadius="16dp"
    app:cardElevation="8dp">

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="16dp">

        <ImageView
            android:id="@+id/stateIcon"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:src="@drawable/ic_pending"
            android:layout_alignParentStart="true" />

        <LinearLayout
            android:id="@+id/infoSection"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_toEndOf="@id/stateIcon"
            android:layout_marginStart="16dp"
            android:orientation="vertical">

            <TextView
                android:id="@+id/bookRecordID"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:text="Booking ID: 12345"
                android:textSize="18sp"
                android:textStyle="bold"
                android:textColor="#1E1E1E" />

            <TextView
                android:id="@+id/tvHelperName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Booking Request"
                android:textSize="15sp"
                android:textColor="#1E1E1E"
                android:layout_marginTop="10dp"/>

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <ImageView
                    android:id="@+id/employerIcon"
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:src="@drawable/ic_reuser" />

                <TextView
                    android:id="@+id/tvEmployerName"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:text="PName"
                    android:textSize="14sp"
                    android:textColor="#6B7280" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <ImageView
                    android:id="@+id/agentIcon"
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:src="@drawable/ic_reuser" />

                <TextView
                    android:id="@+id/tvAgentName"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:text="PName"
                    android:textSize="14sp"
                    android:textColor="#6B7280" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <ImageView
                    android:id="@+id/tranIcon"
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:src="@drawable/ic_reuser" />

                <TextView
                    android:id="@+id/tvTranName"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:text="PName"
                    android:textSize="14sp"
                    android:textColor="#6B7280" />
            </LinearLayout>

        </LinearLayout>

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentEnd="true"
            android:orientation="vertical"
            android:gravity="end"
            android:layout_marginTop="40dp">

            <ImageView
                android:layout_marginTop="30dp"
                android:id="@+id/DetailIcon"
                android:layout_width="50dp"
                android:layout_height="50dp"
                android:src="@drawable/ic_arrow_circle_right" />

            <TextView
                android:id="@+id/booktatus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="25dp"
                android:text="Pending Confirmation"
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="#4B5563" />

        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_below="@id/infoSection"
            android:layout_marginTop="40dp"
            android:background="#E5E7EB" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_below="@id/infoSection"
            android:layout_marginTop="40dp"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/tvDate"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="1-1-2025"
                    android:textColor="#7C3AED"
                    android:textSize="18sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvTime"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="12:00 AM to 12:00 AM"
                    android:textColor="#1F2937"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:layout_marginLeft="30dp"/>
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="end"
                android:layout_marginTop="12dp">

                <Button
                    android:id="@+id/btnJoin"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="12dp"
                    android:backgroundTint="#0EA5E9"
                    android:paddingStart="16dp"
                    android:paddingEnd="16dp"
                    android:text="JOIN MEETING"
                    android:textColor="@android:color/white"
                    android:textAllCaps="false"
                    android:elevation="4dp"
                    android:visibility="gone"/>

                <Button
                    android:id="@+id/btnCancel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:backgroundTint="#DC2626"
                    android:paddingStart="16dp"
                    android:paddingEnd="16dp"
                    android:text="CANCEL"
                    android:textColor="@android:color/white"
                    android:textAllCaps="false"
                    android:elevation="4dp"
                    android:visibility="gone"/>

                <Button
                    android:id="@+id/btnHire"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="12dp"
                    android:backgroundTint="#0EA5E9"
                    android:paddingStart="16dp"
                    android:paddingEnd="16dp"
                    android:text="CONFIRM HIRE"
                    android:textColor="@android:color/white"
                    android:textAllCaps="false"
                    android:elevation="4dp"
                    android:visibility="gone"/>

                <Button
                    android:id="@+id/btnNotHiring"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:backgroundTint="#E53935"
                    android:paddingStart="16dp"
                    android:paddingEnd="16dp"
                    android:text="NOT HIRING"
                    android:textColor="@android:color/white"
                    android:textAllCaps="false"
                    android:elevation="4dp"
                    android:visibility="gone"/>

                <Button
                    android:id="@+id/btnConfirm"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="12dp"
                    android:backgroundTint="#0EA5E9"
                    android:paddingStart="16dp"
                    android:paddingEnd="16dp"
                    android:text="CONFIRM"
                    android:textColor="@android:color/white"
                    android:textAllCaps="false"
                    android:elevation="4dp"
                    android:visibility="gone"/>
            </LinearLayout>
        </LinearLayout>
    </RelativeLayout>
</androidx.cardview.widget.CardView>