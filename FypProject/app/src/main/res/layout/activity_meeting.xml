<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#E0F7FA">

    <EditText
        android:id="@+id/inputBox"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="32dp"
        android:layout_marginEnd="32dp"
        android:layout_marginTop="48dp"
        android:hint="Enter meeting code"
        android:inputType="text"
        android:padding="16dp"
        android:background="@android:drawable/edit_text"
        android:backgroundTint="#FFFFFF"
        android:textColor="#212121"
        android:textColorHint="#90A4AE"
        android:textSize="18sp"
        android:fontFamily="sans-serif-medium" />

    <!-- Join/Create button -->
    <Button
        android:id="@+id/joinCreateButton"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_below="@id/inputBox"
        android:layout_centerHorizontal="true"
        android:layout_marginTop="24dp"
        android:text="Join/Create"
        android:paddingStart="32dp"
        android:paddingEnd="32dp"
        android:paddingTop="12dp"
        android:paddingBottom="12dp"
        android:backgroundTint="#0288D1"
        android:textColor="@android:color/white"
        android:textSize="16sp"
        android:fontFamily="sans-serif-bold"
        android:textAllCaps="false"
        android:stateListAnimator="@null" />

    <!-- Share button -->
    <Button
        android:id="@+id/ShareCode"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_below="@id/joinCreateButton"
        android:layout_centerHorizontal="true"
        android:layout_marginTop="24dp"
        android:text="Share Code"
        android:paddingStart="32dp"
        android:paddingEnd="32dp"
        android:paddingTop="12dp"
        android:paddingBottom="12dp"
        android:backgroundTint="#388E3C"
        android:textColor="@android:color/white"
        android:textSize="16sp"
        android:fontFamily="sans-serif-bold"
        android:textAllCaps="false"
        android:stateListAnimator="@null" />

    <!-- Container for Jitsi meeting view -->
    <FrameLayout
        android:id="@+id/meetingContainer"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_below="@id/ShareCode"
        android:layout_marginTop="32dp"
        android:background="#263238" >

        <com.google.android.material.floatingactionbutton.FloatingActionButton
            android:id="@+id/leaveButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom|end"
            android:layout_marginEnd="0dp"
            android:layout_marginBottom="0dp"
            android:contentDescription="Leave meeting"
            android:src="@android:drawable/ic_menu_close_clear_cancel"
            app:backgroundTint="#EF5350"
            app:elevation="8dp"
            app:fabSize="normal"
            app:pressedTranslationZ="12dp"
            app:rippleColor="#D81B60" />

    </FrameLayout>

    <!-- Questions button (FAB, middle-right) -->
    <com.google.android.material.floatingactionbutton.FloatingActionButton
        android:id="@+id/questionsButton"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignParentEnd="true"
        android:layout_centerVertical="true"
        android:layout_marginEnd="32dp"
        android:src="@android:drawable/ic_menu_help"
        android:contentDescription="Show meeting questions"
        app:backgroundTint="#FFCA28"
        app:fabSize="normal"
        app:rippleColor="#FFB300"
        app:elevation="8dp"
        app:pressedTranslationZ="12dp" />

    <!-- Leave button (FAB, bottom-right) -->

</RelativeLayout>